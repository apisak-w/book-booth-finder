{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["legacy/**", "_site/**", ".svelte-kit/**", "tools/golden/**", "tools/migrate/**"],
  "rules": {
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  }
}
